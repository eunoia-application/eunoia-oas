# Только @eunoia-application уходит в GitHub Packages.
# Публичные пакеты (js-yaml, openapi-typescript, typescript) ставятся с npmjs по
# умолчанию — НЕ добавляйте глобальный `registry=`, иначе обычные npm-зависимости
# начнут 404-ить.
@eunoia-application:registry=https://npm.pkg.github.com

# Аутентификация через env (токен не коммитим). В CI — NODE_AUTH_TOKEN/GITHUB_TOKEN.
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
